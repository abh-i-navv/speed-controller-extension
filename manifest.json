{
  "manifest_version": 3,
  "name": "Universal Video Speed Control",
  "version": "2.0.0",
  "description": "Control HTML5 video playback speed across websites.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_title": "Video Speed Control",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}