{
  "manifest_version": 3,
  "name": "VideoTune",
  "version": "16.9",
  "description": "Speed, 600% volume boost, EQ, bass/treble and a floating video controller.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "scripting"
  ],
  "action": {
    "default_title": "VideoTune",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}